---
import { TOOLS } from '@pdftools/contracts/tools';
import { toolsIndexSeo } from '../../../../web/src/lib/seo';
import Base from '../../layouts/Base.astro';

// Single-sourced: the snapshot's head tags are the SPA's (`apps/web/src/lib/seo.ts`). Only the canonical comes
// from `Astro.site` (via `Base`), so a non-production build never ships a production canonical.
const meta = toolsIndexSeo(
  TOOLS.length,
  TOOLS.map((tool) => ({ id: tool.id, title: tool.title, summary: tool.summary })),
);
const byCategory = new Map<string, typeof TOOLS>();
for (const tool of TOOLS) {
  const list = byCategory.get(tool.category) ?? [];
  list.push(tool);
  byCategory.set(tool.category, list);
}
---

<Base
  title={meta.title}
  description={meta.description}
  canonicalPath="/tools/"
  ogType={meta.ogType}
  keywords={meta.keywords}
  ogImage={meta.ogImage}
  alternates={[
    { hrefLang: 'en', href: `${meta.canonical}` },
    { hrefLang: 'id', href: `${meta.canonical.replace(/\/tools$/, '')}/id/tools` },
    { hrefLang: 'x-default', href: `${meta.canonical}` },
  ]}
  jsonLd={meta.jsonLd}
>
  <h1>All tools</h1>
  <p>Everything the API exposes. Availability, size ceilings, and page limits come from your plan and are applied on the server.</p>
  {[...byCategory].map(([category, tools]) => (
    <section>
      <h2>{category}</h2>
      <ul>
        {tools.map((tool) => (
          <li>
            <a href={`/tools/${tool.id}/`}>{tool.title}</a> — {tool.summary}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
