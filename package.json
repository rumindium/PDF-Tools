{
  "name": "pdf-tools",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "workers/*"],
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web dev:worker",
    "dev:api": "bun run --filter @pdftools/api dev",
    "dev:web": "bun run --filter @pdftools/web dev",
    "dev:worker": "bun run --filter @pdftools/worker-${WORKER_POOL:-light} dev",
    "build": "bun run --filter @pdftools/web build",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fixtures": "bun run scripts/dev/make-fixtures.ts",
    "fixtures:scan": "bun run scripts/dev/make-scan-fixture.ts",
    "fixtures:images": "bun run scripts/dev/make-image-fixtures.ts",
    "fixtures:compress": "bun run scripts/dev/make-compress-fixture.ts",
    "fixtures:large": "bun run scripts/dev/make-large-fixture.ts",
    "fixtures:encrypted": "bun run scripts/dev/make-encrypted-fixture.ts",
    "fixtures:form": "bun run scripts/dev/make-form-fixture.ts",
    "fixtures:redact": "bun run scripts/dev/make-redact-fixture.ts",
    "db:migrate": "bun run scripts/ops/migrate.ts",
    "db:seed": "bun run scripts/dev/seed.ts",
    "ops:preflight": "bun run scripts/ops/preflight.ts",
    "ops:smoke": "bun run scripts/ops/smoke.ts",
    "sweeper": "bun run scripts/ops/sweeper.ts",
    "secrets:audit": "bun run scripts/ops/scrub-job-secrets.ts",
    "engines:check": "bun run scripts/ops/engine-versions.ts",
    "boundaries": "bun run scripts/ci/check-boundaries.ts",
    "doc:parity": "bun run scripts/ci/doc-parity.ts",
    "seo:snapshot": "bun run scripts/ci/seo-snapshot.ts",
    "test:cwv": "bun run scripts/ci/cwv-probe.ts",
    "test:golden": "bun run scripts/ci/golden.ts",
    "test:falsify": "bun run scripts/ci/falsify.ts",
    "test:load": "bun run scripts/ci/load.ts",
    "test:isolation": "bun run scripts/ci/isolation.ts",
    "test:pdfa": "bun run scripts/ci/pdfa-validator.ts",
    "test:tenant-first": "bun run scripts/ci/tenant-first.ts",
    "test:sso-signout": "bun run scripts/ci/sso-signout.ts",
    "test:base14": "bun run scripts/ci/base14-metrics.ts",
    "test:placement": "bun run scripts/ci/placement.ts",
    "test:limits": "bun run scripts/ci/limits.ts",
    "test:browser": "playwright test",
    "e2e:merge": "bun run e2e/merge.e2e.ts",
    "e2e:tool": "bun run e2e/tool.e2e.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.2"
  }
}
