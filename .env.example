# ─────────────────────────────────────────────────────────────────────────────
# PDF Tools — environment contract (docs/0-CONFIG.md)
#
# Copy to `.env` and adjust. Every value here is parsed once, at boot, by
# `packages/config/src/env.ts`; a malformed value fails the process immediately
# instead of surfacing at 3 a.m. mid-job. Ports below are chosen to avoid the
# Auth Platform (5433/6379) and Procurement Platform (5434/6381) stacks.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info
LOG_PRETTY=true

# ── Ports and URLs ───────────────────────────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:8080
# Browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5180
# Public origin baked into sitemap.xml and the crawler snapshot at image build
# time (the SPA itself resolves the origin at runtime, so it needs no rebuild).
# In production this must be the real domain, e.g. SEO_SITE_URL=https://pdf.example.id
# — `docker-compose.prod.yml` defaults it to `https://${PUBLIC_HOST}`.
SEO_SITE_URL=https://pdf.rumindium.id
# Auth Platform. Leave empty for anonymous-only mode: no SSO, no permission gate.
# Inside compose use the service name; from the host use http://localhost:5100.
AUTH_PLATFORM_URL=
AUTH_PLATFORM_INTERNAL_URL=

# ── Access (who may use this installation at all) ────────────────────────────
# The shipped default for ALLOW_ANONYMOUS is `false`: an installation is tenant-first
# unless an operator says otherwise. This file is a *development* profile and the
# golden suite, the property stages and the browser cases all start from an anonymous
# session, so it is on here. In production the switch is owned by Auth Platform →
# Administration → Apps (`Allow anonymous` on the app record), and this variable is
# only the fallback for a stack that cannot reach the platform — which is every CI
# stack, and which is why the fallback exists at all (`docs/0-TENANT-FIRST.md` §3.2).
ALLOW_ANONYMOUS=true
# The app whose admin record owns that switch.
AUTH_PLATFORM_APP_CODE=pdf-tools
# How long a resolved answer — including a failed lookup — is trusted, in seconds.
APP_ANONYMOUS_CACHE_SECONDS=60
# The name of Auth Platform's shared-session cookie — the bridge the sign-in gate reads
# (`POST /api/v1/sso/probe`). It is set by the platform's own web app on a host-only
# domain, so in development every port on `localhost` already sees it, and in production
# the app and the platform must share a host (or the platform must set a parent domain).
AUTH_PLATFORM_SESSION_COOKIE=auth_session
# How many probes one IP hash may make per minute, before Auth Platform is asked.
SSO_PROBE_PER_MINUTE=12

# ── Storage (TEMP_DIR and STAGING_DIR must be on the same volume) ────────────
TEMP_DIR=/var/lib/pdf-tools/jobs
STAGING_DIR=/var/lib/pdf-tools/staging
JOB_TTL_MINUTES=30
UPLOAD_TTL_MINUTES=60
FAILED_TTL_MINUTES=60
FS_SWEEP_INTERVAL_SECONDS=300
FS_SWEEP_MAX_AGE_MINUTES=180
CLEANUP_INTERVAL_SECONDS=60
WORKER_DISK_MIN_FREE_GB=5

# ── Database and queue ───────────────────────────────────────────────────────
DATABASE_URL=postgres://pdftools:pdftools@localhost:5435/pdftools
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6382
JOB_MAX_ATTEMPTS=2
JOB_BACKOFF_MS=2000
JOB_STALLED_MS=120000

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
MAX_JOB_SIZE_MB=100
MAX_PAGES_ANONYMOUS=200
MAX_JOBS_PER_HOUR_ANONYMOUS=10
MAX_CONCURRENT_JOBS_PER_SESSION=2
RATE_LIMIT_PER_MINUTE=60
UPLOAD_CONCURRENCY=3
MAX_SPLIT_PARTS=200
SSE_HEARTBEAT_SECONDS=15
PROGRESS_MIN_INTERVAL_MS=500
IDEMPOTENCY_TTL_HOURS=24
ENGINE_LOG_TAIL_BYTES=4096
ENGINE_KILL_GRACE_SECONDS=5

# ── Anonymous session ────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=pdft_session
# MUST be replaced outside development (scripts/ops/preflight.ts enforces this).
SESSION_SECRET=dev-only-change-me
ANON_SESSION_TTL_HOURS=24

# ── Workers (WORKER_POOL selects the queue each worker process consumes) ─────
WORKER_POOL=light
WORKER_ID=
WORKER_LIGHT_CONCURRENCY=4
WORKER_OFFICE_CONCURRENCY=2
WORKER_HEAVY_CONCURRENCY=2
WORKER_OCR_CONCURRENCY=2
SHUTDOWN_GRACE_SECONDS=30
LIBREOFFICE_TIMEOUT_SECONDS=300
# Compose also fences each pool worker with a container ceiling of its own — `cpus`,
# `mem_limit` and `memswap_limit` per pool in docker-compose.yml and
# docker-compose.prod.yml, interpolated from these. The defaults are already wired
# into compose (nothing to set on a normal host): concurrency × the pool's largest
# catalog memory budget + 1 GB of headroom, so a pool can run every slot at its
# worst-case budget at once — a container ceiling sits *beside* the per-engine
# RLIMIT_AS budget, it does not replace it. Override only on a host too small for
# the pools' sum; the 6 GB sandbox VM that first needed them is the example.
#WORKER_LIGHT_CPUS=4
#WORKER_LIGHT_MEM_LIMIT=9g
#WORKER_OFFICE_CPUS=2
#WORKER_OFFICE_MEM_LIMIT=4g
#WORKER_HEAVY_CPUS=2
#WORKER_HEAVY_MEM_LIMIT=7g
#WORKER_OCR_CPUS=2
#WORKER_OCR_MEM_LIMIT=7g

# ── Engine paths (empty = resolve from PATH) ─────────────────────────────────
ENGINE_QPDF_PATH=
ENGINE_GS_PATH=
ENGINE_MUTOOL_PATH=
ENGINE_SOFFICE_PATH=
ENGINE_MAGICK_PATH=
ENGINE_OCRMYPDF_PATH=
ENGINE_TESSERACT_PATH=
# /opt/verapdf/verapdf in the heavy image; empty means "no validator in this deployment".
ENGINE_VERAPDF_PATH=
ENGINE_PYTHON_PATH=python3

# ── Tool feature flags ───────────────────────────────────────────────────────
TOOL_MERGE_ENABLED=true
TOOL_SPLIT_ENABLED=true
TOOL_PDF_TO_IMAGES_ENABLED=true
TOOL_OFFICE_TO_PDF_ENABLED=true
TOOL_PDF_TO_PDFA_ENABLED=true
TOOL_OCR_ENABLED=true
# On by default: the heavy image ships veraPDF (18 MB, CLI pack only — the "~200 MB"
# figure this default used to cite was the GUI distribution). A job whose output fails
# validation is withheld (`PDFA_CONFORMANCE_FAILED`). Set false only for an image built
# without the validator, where jobs then report `CONFORMANCE_NOT_VALIDATED` instead.
PDFA_VALIDATE=true
